{
  "name": "barber-bar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply barber-bar-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply barber-bar-db --remote",
    "db:seed:local": "wrangler d1 execute barber-bar-db --local --file=db/seed/0001_demo.sql"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.3",
    "better-auth": "^1.7.27",
    "next": "^16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@cloudflare/workers-types": "^5.20261121.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.36.0"
  }
}
