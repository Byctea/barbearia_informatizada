{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "barberflow",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "BETTER_AUTH_URL": "https://barberflow.ecsnote88.workers.dev",
    "EMAIL_FROM": "onboarding@resend.dev"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "barberflow", "environment": "production" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "barber-bar-db",
      "database_id": "e31a6ff1-9efd-46d4-af16-9aceede89f74",
      "migrations_dir": "db/migrations"
    }
  ],
  "observability": { "enabled": true }
}
