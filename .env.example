# Copie para .dev.vars (Cloudflare local) ou .env.local (Next.js local).
# Nunca coloque secrets reais neste arquivo nem faça commit dos arquivos locais.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=gere-um-segredo-aleatorio-com-no-minimo-32-caracteres
# Configure um token aleatorio antes do primeiro acesso master.
PLATFORM_ADMIN_BOOTSTRAP_TOKEN=gere-um-token-aleatorio-e-de-uso-unico
# E-mail transacional (Resend). Configure também RESEND_API_KEY e EMAIL_FROM como secrets/vars do Worker.
RESEND_API_KEY=re_sua_chave_de_api
EMAIL_FROM=Barber Flow <convites@seu-dominio.com>
